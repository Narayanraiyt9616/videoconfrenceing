# MeetHub Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Local daemon or MongoDB Atlas URI)
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.mongodb.net/meethub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/meethub

# JWT Authentication Secret
JWT_SECRET=meethub-jwt-super-secret-key-change-in-production-2026

# Active Room Cleanup Timeouts
INACTIVITY_TIMEOUT_MS=1800000
CLEANUP_INTERVAL_MS=30000
