{
  "watch": [
    "server.js",
    "memory",
    "middleware",
    "routes",
    "sockets",
    "utils",
    "config",
    "models"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules",
    "data",
    "data/**",
    "../client",
    "../scripts",
    "*.log"
  ],
  "stdin": false,
  "delay": 200
}
