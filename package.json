{
  "name": "aaj-ka-kalesh-root",
  "version": "1.0.0",
  "description": "Aaj Ka Kalesh 🔥 - Real-time Temporary Social Hangout with ZERO database",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client",
    "verify:nodb": "node scripts/verify-nodb.js",
    "test:simulation": "npm run test:simulation --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
